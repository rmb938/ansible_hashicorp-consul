{{- with pkiCert "pki_consul_rpc_intermediate/issue/pki_consul_rpc_intermediate_default" "common_name=server.hl-us-homelab1.consul" -}}
{{ .Cert }}{{ .CA }}{{ .CAChain }}{{ .Key }}
{{ .Key | writeToFile "/opt/consul/tls/internal_rpc.key" "" "" "0600" }}
{{ (printf "%s%s" .Cert (.CAChain | join "")) | writeToFile "/opt/consul/tls/internal_rpc.crt" "" "" "0644" }}
{{- end -}}